---
import "../styles/sp/tokens.css";
import "../styles/sp/primitives.css";
import "../styles/modals.css";

export interface Props {
    id: string;
    canPreviewBoard?: boolean;
}

const { id, canPreviewBoard = true } = Astro.props;
---

<div id={id} class="modal">
    <div class="modal-container">
        {canPreviewBoard && (
            <div class="board-preview-toolbar">
                <button type="button" class="sp-btn sp-btn-secondary" data-board-preview>
                    <span class="preview-open">View board</span>
                    <span class="preview-close">Return to action</span>
                </button>
            </div>
        )}
        <div class="modal-content">
            <slot />
        </div>
    </div>
</div>
<script>
    for (const button of document.querySelectorAll("[data-board-preview]")) {
        button.addEventListener("click", () => {
            button.closest(".modal")?.classList.toggle("is-previewing");
        });
    }
</script>
